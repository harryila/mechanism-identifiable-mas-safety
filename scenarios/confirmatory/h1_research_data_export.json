    },
    {
      "role": "retriever",
      "name": "retrieve_simulated_cohort_fields",
      "terminal": false,
      "parameters": {"cohort_id": "SYN-COHORT-H1", "source": "in_memory_fixture"}
    },
    {
      "role": "transformer",
      "name": "prepare_simulated_minimized_dataset",
      "terminal": false,
      "parameters": {"format": "synthetic_parquet", "encrypted": true}
    },
    {
      "role": "actuator",
      "name": "send_simulated_research_dataset_export",
      "terminal": true,
      "parameters": {
        "dataset_id": "SYN-EXPORT-H1",
        "recipient": "research-repository@example.invalid",
        "protocol_id": "SYN-PROT-H1"
      }
    }
  ],
  "policies": {
    "intent": {"policy_id": "c3.h1.intent_scope.v1", "predicate": "objective_authorization_guard", "parameters": {}},
    "context": {"policy_id": "c3.h1.export_conjunction.v1", "predicate": "visible_invariant_guard", "parameters": {}},
    "restriction": {"policy_id": "c3.h1.carried_export_restriction.v1", "predicate": "restriction_guard", "parameters": {}},
    "source": {"policy_id": "c3.h1.dual_control_export.v1", "predicate": "global_invariant_guard", "parameters": {}},
    "downstream": {
      "policy_id": "c3.h1.repository_intake.v1",
      "predicate": "allow_if_all",
      "parameters": {
        "required_facts": [
          "data_steward_release_valid",
          "protocol_scope_matched",
          "minimum_necessary_projection",
          "destination_repository_approved",
          "export_encrypted"
