    },
    "single_agent": {"policy_id": "c3.h1.full_context.v1", "predicate": "global_invariant_guard", "parameters": {}}
  },
  "context_fragments": {
    "planner": ["ethics_countersignature_valid", "protocol_scope_matched"],
    "retriever": ["data_steward_release_valid"],
    "transformer": ["minimum_necessary_projection", "export_encrypted"],
