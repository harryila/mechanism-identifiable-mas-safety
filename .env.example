# Never commit populated credentials. The CLI reads these from the process environment.
OPENAI_API_KEY=

# Generate a new random value for each real experiment; decode length must be >=32 bytes.
MAS_SAFETY_PROVENANCE_KEY_B64=

# Optional non-secret label. If omitted, the CLI derives a one-way key fingerprint.
MAS_SAFETY_PROVENANCE_KEY_ID=

# Stage 4 uses a separate credential boundary. Never copy a Stage 1 key here,
# and never use a credential that has appeared in chat, logs, or source control.
MAS_SAFETY_STAGE4_API_KEY=

# Generate a fresh Stage 4-only random value; decoded length must be >=32 bytes.
MAS_SAFETY_STAGE4_PROVENANCE_KEY_B64=

# Non-secret identifiers/fingerprints must match the eventual final freeze.
MAS_SAFETY_STAGE4_PROVENANCE_KEY_ID=
